# Global Environment Variables for Docker Compose
# Copy this file to .env and fill in your actual values

# Database Configuration
MONGODB_CONNECTION_STRING=mongodb://mongo_user:mongo_password@mongodb:27017/fooddelivery
MONGO_USERNAME=mongo_user
MONGO_PASSWORD=mongo_password

# Auth0 Configuration (shared across all services)
AUTH0_AUDIENCE=your_auth0_audience
AUTH0_ISSUER_BASE_URL=https://your-domain.auth0.com

# Cloudinary Configuration (for Restaurant Service)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Configuration (for Order Service)
STRIPE_API_KEY=sk_test_your_stripe_api_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Frontend URL
FRONTEND_URL=http://localhost:3000
