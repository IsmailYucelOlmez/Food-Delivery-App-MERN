{
  "name": "food-delivery-microservices",
  "version": "1.0.0",
  "description": "Food delivery application built with microservices architecture",
  "main": "./services/api-gateway/src/index.ts",
  "scripts": {
    "dev": "concurrently \"npm run dev:user\" \"npm run dev:restaurant\" \"npm run dev:order\" \"npm run dev:driver\" \"npm run dev:gateway\"",
    "dev:user": "cd services/user-service && npm run dev",
    "dev:restaurant": "cd services/restaurant-service && npm run dev", 
    "dev:order": "cd services/order-service && npm run dev",
    "dev:driver": "cd services/driver-service && npm run dev",
    "dev:gateway": "cd services/api-gateway && npm run dev",
    "install:all": "npm run install:user && npm run install:restaurant && npm run install:order && npm run install:driver && npm run install:gateway",
    "install:user": "cd services/user-service && npm install",
    "install:restaurant": "cd services/restaurant-service && npm install",
    "install:order": "cd services/order-service && npm install", 
    "install:driver": "cd services/driver-service && npm install",
    "install:gateway": "cd services/api-gateway && npm install",
    "build:all": "npm run build:user && npm run build:restaurant && npm run build:order && npm run build:driver && npm run build:gateway",
    "build:user": "cd services/user-service && npm run build",
    "build:restaurant": "cd services/restaurant-service && npm run build",
    "build:order": "cd services/order-service && npm run build",
    "build:driver": "cd services/driver-service && npm run build",
    "build:gateway": "cd services/api-gateway && npm run build",
    "start:all": "concurrently \"npm run start:user\" \"npm run start:restaurant\" \"npm run start:order\" \"npm run start:driver\" \"npm run start:gateway\"",
    "start:user": "cd services/user-service && npm start",
    "start:restaurant": "cd services/restaurant-service && npm start",
    "start:order": "cd services/order-service && npm start",
    "start:driver": "cd services/driver-service && npm start",
    "start:gateway": "cd services/api-gateway && npm start",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "stripe": "npm run stripe:order",
    "stripe:order": "cd services/order-service && npm run stripe"
  },
  "keywords": ["microservices", "food-delivery", "nodejs", "typescript"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}